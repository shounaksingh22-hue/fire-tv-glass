<resources>
    <style name="Pill">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_marginStart">12dp</item>
        <item name="android:background">@drawable/pill_bg</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">18dp</item>
    </style>
    <!-- Icon-only round pill (Free memory, Customize) -->
    <style name="PillRound" parent="Pill">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:minWidth">40dp</item>
        <item name="android:paddingStart">11dp</item>
        <item name="android:paddingEnd">11dp</item>
        <item name="android:gravity">center</item>
    </style>
    <style name="PillIcon">
        <item name="android:layout_width">18dp</item>
        <item name="android:layout_height">18dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:alpha">0.85</item>
    </style>
    <style name="PillText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:maxWidth">200dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">#E6FFFFFF</item>
        <item name="android:textSize">15sp</item>
    </style>
</resources>
