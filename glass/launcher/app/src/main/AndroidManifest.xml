<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Weather line only (Open-Meteo + ipapi.co); nothing else in Glass goes online -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 11 only reveals the Wi-Fi name to apps holding location; granted by install.sh -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Free memory button: closes cached background apps -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <!-- The phone remote's Sleep key wakes the TV again -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Customize switches the screensaver (Aerial Views or Paintings); granted over ADB by tv-kit -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Settings button: the pages it may link to (SettingsSheet checks which ones this TV allows) -->
        <intent><action android:name="android.settings.WIFI_SETTINGS" /></intent>
        <intent><action android:name="android.settings.WIRELESS_SETTINGS" /></intent>
        <intent><action android:name="android.settings.DISPLAY_SETTINGS" /></intent>
        <intent><action android:name="android.settings.SOUND_SETTINGS" /></intent>
        <intent><action android:name="android.settings.APPLICATION_SETTINGS" /></intent>
        <intent><action android:name="android.settings.BLUETOOTH_SETTINGS" /></intent>
        <intent><action android:name="android.settings.ACCESSIBILITY_SETTINGS" /></intent>
        <intent><action android:name="android.settings.LOCALE_SETTINGS" /></intent>
        <intent><action android:name="android.settings.DATE_SETTINGS" /></intent>
        <intent><action android:name="android.settings.SYNC_SETTINGS" /></intent>
        <intent><action android:name="android.settings.DEVICE_INFO_SETTINGS" /></intent>
        <intent><action android:name="android.settings.SETTINGS" /></intent>
        <intent><action android:name="com.amazon.device.settings.action.DISPLAY_AND_SOUNDS" /></intent>
        <intent><action android:name="com.amazon.device.settings.action.APPLICATIONS" /></intent>
        <intent><action android:name="com.amazon.device.settings.action.CONTROLLERS" /></intent>
        <intent><action android:name="com.amazon.device.settings.action.PREFERENCES" /></intent>
        <intent><action android:name="com.amazon.device.settings.action.DATE_TIME" /></intent>
        <intent><action android:name="com.amazon.device.settings.action.MY_ACCOUNT" /></intent>
        <intent><action android:name="com.amazon.device.settings.action.DEVICE" /></intent>
        <package android:name="com.amazon.tv.launcher" />
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@drawable/banner"
        android:banner="@drawable/banner"
        android:allowBackup="false"
        android:supportsRtl="false"
        android:theme="@style/Theme.Glass">

        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:resumeWhilePausing="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|density|fontScale|locale|layoutDirection">
            <intent-filter android:priority="1">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Fire OS won't let the Amazon launcher be disabled: this redirects Home to Glass -->
        <service
            android:name=".HomeButtonService"
            android:exported="true"
            android:label="@string/a11y_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/home_button_service" />
        </service>

        <!-- Paintings on demand (Tools > Paintings), the same wall as the screensaver -->
        <activity
            android:name=".PaintingsActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />

        <!-- The Paintings screensaver -->
        <service
            android:name=".PaintingsDream"
            android:exported="true"
            android:label="Glass Paintings"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!-- Turns the screen off for the phone remote's Sleep key (see SleepAdmin) -->
        <receiver
            android:name=".SleepAdmin"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/sleep_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
