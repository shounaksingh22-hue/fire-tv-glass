<?xml version="1.0" encoding="utf-8"?>
<!-- Dock band: clear glass — a whisper of frost, a gloss across the top, a bright hairline edge -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="30dp" />
            <gradient android:angle="270" android:startColor="#2EFFFFFF" android:endColor="#0DFFFFFF" />
        </shape>
    </item>
    <item android:bottom="96dp">
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="30dp" android:topRightRadius="30dp" />
            <gradient android:angle="270" android:startColor="#1FFFFFFF" android:endColor="#00FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="30dp" />
            <stroke android:width="1dp" android:color="#47FFFFFF" />
        </shape>
    </item>
</layer-list>
